DEMO_MODE=true
STORAGE_BACKEND=filesystem
FS_ROOT=./data
S3_BUCKET=agentjetson

# Production MinIO / S3
# DEMO_MODE=false
# STORAGE_BACKEND=minio
# S3_ENDPOINT=localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_USE_SSL=false
# S3_FORCE_PATH_STYLE=true
# S3_REGION=us-east-1

GRPC_ADDR=0.0.0.0:50055
HTTP_ADDR=0.0.0.0:8081

# ClickHouse metadata store (object_meta). Off in DEMO_MODE.
# After Put, InsertObjectMeta is called; Get/List/MarkDeleted query the same table.
CLICKHOUSE_ENABLED=false
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=pass
CLICKHOUSE_DB=default
# Optional alias (docs / older compose):
# CLICKHOUSE_DSN=clickhouse://default:pass@localhost:9000/default
